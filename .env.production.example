# =================================================================
# SHTCA PRODUCTION CONFIGURATION (.env.production)
# =================================================================

# 1. Domains & SSL (Caddy Auto-HTTPS)
DOMAIN_NAME=shtca.com
API_DOMAIN=api.shtca.com
ACME_EMAIL=admin@shtca.com

# 2. Security (Generate via: openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_base64_jwt_secret

# 3. Database Connection String (MongoDB Atlas or Cloud MongoDB)
# Example: mongodb+srv://shtca_user:strongpassword@cluster0.abcde.mongodb.net/shtca?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/shtca?retryWrites=true&w=majority

# 4. Email Service (Password Reset & OTP - Optional)
EMAIL_HOST=mail.suremarkettips.com
EMAIL_PORT=587
EMAIL_USER=contact@suremarkettips.com
EMAIL_PASS=replace_with_your_smtp_password
