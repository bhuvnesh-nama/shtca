# ==========================================
# SECRETS & ENVIRONMENT FILES (NEVER COMMIT)
# ==========================================
.env
.env.*
*.env
backend/.env*
frontend/.env*
mobile/.env*
docker-compose.override.yml

# Whitelist safe example templates
!.env.example
!.env.production.example
!backend/.env.example
!frontend/.env.example

# ==========================================
# DEPENDENCIES & PACKAGE CACHES
# ==========================================
node_modules/
*/node_modules/
.pnp
.pnp.js
.npm/

# ==========================================
# PRODUCTION BUILDS & COMPILED ARTIFACTS
# ==========================================
dist/
*/dist/
build/
*/build/
.output/
.vercel/

# ==========================================
# FLUTTER & DART BUILD ARTIFACTS
# ==========================================
.dart_tool/
*/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
*.apk
*.aab
*.ipa

# ==========================================
# LOGS & SYSTEM
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# OS & EDITOR METADATA
# ==========================================
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
tmp/
coverage/

# ==========================================
# SSL CERTIFICATES & KEYS
# ==========================================
*.pem
*.key
*.crt
*.cert

