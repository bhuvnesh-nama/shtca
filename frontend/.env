VITE_API_BASE_URL="http://localhost:8000"

# Map Provider & Tile Service Configuration
# Default is "osm" (Free OpenStreetMap - No API key needed, zero watermarks)
VITE_MAP_PROVIDER="osm"
VITE_MAP_TILES_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"

# Optional API Keys (Only if you want to use proprietary basemaps instead of free OpenStreetMap)
# Carto Basemaps Key (Get free key from https://carto.com/basemaps/apikey)
VITE_CARTO_API_KEY=""

# MapTiler API Key (Get free key from https://cloud.maptiler.com)
VITE_MAPTILER_API_KEY=""
