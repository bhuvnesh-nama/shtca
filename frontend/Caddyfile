{
    email {$ACME_EMAIL:admin@shtca.com}
    admin off
}

# =================================================================
# 1. DEDICATED BACKEND API GATEWAY (api.shtca.com)
# Powers Flutter Mobile App, Background Services & REST APIs
# =================================================================
api.{$DOMAIN_NAME:shtca.com} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept"
        -Server
    }

    @options {
        method OPTIONS
    }
    handle @options {
        respond 204
    }

    reverse_proxy backend:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# =================================================================
# 2. CITIZEN & OFFICER WEB APPLICATION (shtca.com & www.shtca.com)
# Hosts React SPA & Built-in Reverse Proxy Fallback
# =================================================================
{$DOMAIN_NAME:shtca.com}, www.{$DOMAIN_NAME:shtca.com} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(self), camera=(), microphone=()"
        -Server
    }

    handle /public/* {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /socket.io/* {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /api/* {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Hashed static bundle assets (safe for long-term immutable caching)
    handle /assets/* {
        root * /var/www/html
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # PWA Service Worker & Manifest (strictly never cache)
    @noCache path /sw.js /manifest.json
    handle @noCache {
        root * /var/www/html
        header Cache-Control "no-cache, no-store, must-revalidate"
        file_server
    }

    # Single Page Application (SPA) entry point (never cache index.html)
    handle {
        root * /var/www/html
        try_files {path} /index.html
        header Cache-Control "no-cache, no-store, must-revalidate"
        file_server
    }
}

